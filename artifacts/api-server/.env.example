# Database (Supabase free tier — use the IPv4 Supavisor pooler, NOT the direct host:
# Supabase direct connections are IPv6-only on the free tier and won't work from Render.
# In Supabase Dashboard → Project Settings → Database → Connection string, pick the
# "Session pooler" (port 5432) string. If the password contains special characters,
# percent-encode them (e.g. $ -> %24).
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"

# Resend (get from https://resend.com)
RESEND_API_KEY="re_..."
EMAIL_FROM="SwiftJob <careers@swiftjob.payservice.top>"
HR_EMAIL="hr@swiftjob.payservice.top"

# Cloudflare R2 (get from Cloudflare Dashboard → R2 → Manage R2 API tokens)
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET="swiftjobsystems"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://pub-your-account-id.r2.dev"

# Auth (generate JWT_SECRET with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
ADMIN_EMAIL="admin@swiftjob.payservice.top"
ADMIN_PASSWORD="secure-password-change-me"

# App
NODE_ENV="development"
PORT="3001"
FRONTEND_URL="http://localhost:5173"