# Copy to .dev.vars and fill in with your real values for local dev.
# This file is committed as documentation only. Never commit .dev.vars.
#
# For production, set these same secrets either via:
#   wrangler secret put <KEY>
# or the Cloudflare dashboard -> Worker -> Settings -> Variables and Secrets.
#
# DATABASE_URL                 Postgres connection string (e.g. Neon/postgres)
DATABASE_URL=postgres://user:pass@host/db
# RESEND_API_KEY               Email provider (Resend) API key
RESEND_API_KEY=
# EMAIL_FROM                   Verified sender, e.g. "SwiftJob HR <no-reply@swiftjob.payservice.top>"
EMAIL_FROM=
# HR_EMAIL                     Where HR/notification emails are sent
HR_EMAIL=
# SUPPORT_EMAIL                Support address shown in emails & referral pages (defaults to HR_EMAIL)
SUPPORT_EMAIL=
# JWT_SECRET                   >= 32 chars, random. Signs admin &candidate tokens.
JWT_SECRET=
# ADMIN_EMAIL               Admin login email
ADMIN_EMAIL=
# ADMIN_PASSWORD            Admin login password
ADMIN_PASSWORD=
# B2_KEY_ID / B2_APP_KEY     Backblaze B2 — private bucket Swift-Private holding SwiftTechCheck.msi (7.1MB).
#                             Only needed for GET /api/tech-check/download/msi/:token.
#                             Keys stay server-side; download links are 15-min signed URLs.
#                             Bucket details: id 35a54763b3883991a8060f14, api https://api005.backblazeb2.com, dl https://f005.backblazeb2.com
B2_KEY_ID=                               # Backblaze App Key ID (restricted to Swift-Private, e.g. 0055573389186f40000000002)
B2_APP_KEY=                              # Backblaze Application Key (server-side secret, keep out of git)
B2_BUCKET_ID=35a54763b3883991a8060f14
B2_BUCKET_NAME=Swift-Private
B2_API_URL=https://api.backblazeb2.com
B2_DOWNLOAD_URL=https://f005.backblazeb2.com